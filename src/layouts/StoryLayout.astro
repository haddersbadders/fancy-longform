---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "A Fancy Longform Story" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="bg-neutral-900 text-neutral-100 antialiased font-sans">
    <header class="fixed top-0 w-full z-50 mix-blend-difference p-6 flex justify-between items-center pointer-events-none">
      <a href="/" class="font-bold text-xl tracking-tighter uppercase pointer-events-auto">Fancy Longform</a>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
