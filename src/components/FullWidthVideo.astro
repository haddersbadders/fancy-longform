---
interface Props {
  videoSrc: string;
  fallbackSrc: string;
}
const { videoSrc, fallbackSrc } = Astro.props;
---

<div class="relative w-full h-screen overflow-hidden bg-black flex items-center justify-center">
  <video 
    class="absolute inset-0 w-full h-full object-cover opacity-80" 
    src={videoSrc} 
    poster={fallbackSrc} 
    autoplay 
    muted 
    loop 
    playsinline
  ></video>
  <div class="relative z-10 w-full h-full bg-black/30 flex items-center justify-center text-center px-4">
    <slot />
  </div>
</div>
